{
    "name": "iswilson/canadapost-api",
    "type": "library",
    "description": "Unofficial PHP library for communicating with Canada Post APIs.",
    "keywords": ["canadapost", "api", "wrapper", "tracking", "shipping", "rate", "rating"],
    "license": "MIT",
    "authors": [
        {
            "name": "Ian Wilson",
            "role": "Maintainer"
        },
        {
            "name": "Jace Bennest",
            "role": "Original author"
        }
    ],
    "require": {
        "php": ">=8.3",
        "guzzlehttp/guzzle": "^7.0",
        "openlss/lib-array2xml": "^0.5.1",
        "ext-dom": "*"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan-phpunit": "^2.1",
        "phpstan/phpstan-strict-rules": "^2.1",
        "phpunit/phpunit": "^12.0"
    },
    "conflict": {
        "thejacer87/canadapost-api": "*"
    },
    "autoload": {
        "psr-4": {
          "CanadaPost\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
          "CanadaPost\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "phpstan/extension-installer": true
        }
    },
    "scripts": {
        "phpstan": "phpstan analyse",
        "cs": "php-cs-fixer check"
    }
}

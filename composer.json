{
    "name": "iswilson/canadapost-api",
    "type": "library",
    "description": "Unofficial PHP library for communicating with Canada Post APIs.",
    "keywords": ["canadapost", "api", "wrapper", "tracking", "shipping", "rate", "rating"],
    "license": "MIT",
    "authors": [
        {
            "name": "Ian Wilson",
            "role": "Maintainer"
        },
        {
            "name": "Jace Bennest",
            "role": "Original author"
        }
    ],
    "require": {
        "php": ">=8.3",
        "guzzlehttp/guzzle": "^7.0",
        "openlss/lib-array2xml": "^0.5.1",
        "psr/log": "^1.0",
        "ext-dom": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^4.8 || ^5.0"
    },
    "conflict": {
        "thejacer87/canadapost-api": "*"
    },
    "autoload": {
        "psr-4": {
          "CanadaPost\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
          "CanadaPost\\Tests\\": "tests/"
        }
    }
}
